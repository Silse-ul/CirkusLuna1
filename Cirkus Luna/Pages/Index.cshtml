@page
@using Cirkus_Luna.Pages.model
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="text-center">
    <h1 class="display-4">Velkommen til Cirkus Luna</h1>
</div>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


<div class="card-group">
    
    @for (int i = 0; i < 4 && i < Model.Performances.Count; i++)
    
    {
        Cirkus_Luna.Pages.model.Performance item = Model.Performances[i];
        
        <div class="card" style=" width: 200px "> 
            <div class="card-body">
                <h5 class="card-title">@item.City</h5>
                <h5 class=" card-subtitle">@item.Date</h5>
            </div>

            <div class="card-footer"> køb her </div>
        </div>
    }
    <div class="card" style=" width: 200px ">
        <img class="card-img-top" src="Image/arrow.jpeg"></img>
        <div class="card-body">
            <h5 class="card-title"></h5>
            <h5 class=" card-subtitle"></h5>
        </div>

        <div class="card-footer">
            <a asp-page="Performances" class="streached-link"> se flere datoer  </a>
        </div>
    </div>
    
    </div>

<hr/>

<div class="card-group bg-danger clearfix" style="padding: 40px">
    
    @for (int i = 0; i < 4 && i < Model.Artists.Count; i++)
    
    {
        Cirkus_Luna.Pages.model.Artist item = Model.Artists[i];
        
        <div class="card" style=" width: 200px ">
            <img class=" float-start" src="@item.ImagePathArtist"></img>
            
        </div>
    }
    <div class="card" style=" width: 200px ">
        <img class=" float-end" src="Image/arrow.jpeg"></img>
        <div class="card-body">
            <a asp-page="artistDetails" class="streached-link"> Se flere artister</a>
        </div>
        
    </div>
</div>