@page
@model Cirkus_Luna.Pages.Ticket

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>
    <h2>Reserver billet</h2>

    <form method="post">

        <div class="mb-3">

            <label>Navn</label>

            <input asp-for="CustomerName"
                   class="form-control" />

        </div>

        <button type="submit"
                class="btn btn-danger">

            Reserver

        </button>

    </form>
    <div class="mb-3">

        <label>Vælg billet type</label>

        <div class="form-check">

            <input class="form-check-input"
                   type="radio"
                   asp-for="Tickets.TicketType"
                   value="Child" />

            <label class="form-check-label">
                Børnebillet - 130 kr
            </label>

        </div>

        <div class="form-check">

            <input class="form-check-input"
                   type="radio"
                   asp-for="Tickets.TicketType"
                   value="Adult" />

            <label class="form-check-label">
                Voksen - 200 kr
            </label>

        </div>

        <div class="form-check">

            <input class="form-check-input"
                   type="radio"
                   asp-for="Tickets.TicketType"
                   value="VIP" />

            <label class="form-check-label">
                VIP - 300 kr
            </label>

        </div>

    </div>
</div>
</body>
</html>