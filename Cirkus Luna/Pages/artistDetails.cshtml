@page
@using Cirkus_Luna.Pages.model
@model Cirkus_Luna.Pages.artistDetails

@{
    Layout = null;
}

<!DOCTYPE html>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<html>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<head>
    <title></title>
</head>
<body>

<div class="text-center">
    <h1 class="display-4">Velkommen til Cirkus Luna</h1>
</div>

<div>
    @foreach (Artist item in Model.Artists)
    {

        <div class="bg-danger d-flex" style="padding: 20px">
            <img class=" float-start me-4" src="@item.ImagePathArtist" style="width: 400px"></img>
            <p class=" title fw-bolder fs-2"> @item.Name</p>
            <p class="fw-bold fs-4">@item.Description </p>

        </div>
        <hr/>

    }


</div>


</body>
</html>